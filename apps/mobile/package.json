{
  "name": "cev-cmms-mobile",
  "private": true,
  "version": "0.1.0",
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "start:tunnel": "expo start --dev-client --tunnel",
    "web": "expo start --web",
    "bundle:web": "expo export --platform web --output-dir dist-web",
    "android": "expo run:android",
    "android:device": "expo run:android --device",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "eas:init": "npx eas-cli@latest init",
    "build:android:dev": "npx eas-cli@latest build --platform android --profile development"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.114.0",
    "expo": "~54.0.20",
    "expo-camera": "~17.0.10",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.1",
    "react-native-web": "~0.21.0",
    "react-native-url-polyfill": "2.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "expo-doctor": "^1.17.13",
    "typescript": "^5.9.3"
  }
}
