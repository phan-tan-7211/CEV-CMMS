{
  "plugins": ["react", "react-perf", "unicorn", "typescript"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react-hooks/set-state-in-effect": "warn",
    "react-hooks/preserve-manual-memoization": "off"
  },
  "ignorePatterns": ["dist/**", "apps/mobile/**"]
}
